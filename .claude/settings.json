{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "[ -f scripts/quick-check.sh ] && bash scripts/quick-check.sh 2>&1 | tail -20 || true" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash scripts/stop-gate.sh" }
        ]
      }
    ]
  }
}

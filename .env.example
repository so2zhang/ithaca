# Copy to .env.local and fill in. Never commit .env.local.

# demo = recorded debrief, no API calls (safe for live demos). Leave empty for real voice + Claude.
DEMO_MODE=mock

# Claude: debrief extraction + text fallback. https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# ElevenLabs Agents: voice debrief. See README "Set up the Bee voice agent".
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
